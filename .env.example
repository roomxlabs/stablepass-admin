# Supabase project (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for the internal push-dispatch Edge Function (verify_jwt=false).
# Sent as the `x-dispatch-secret` header by the admin publish route. SERVER-ONLY —
# never prefix with NEXT_PUBLIC_ and never read it from a client component.
# Must match PUSH_DISPATCH_SECRET set on the Supabase project.
PUSH_DISPATCH_SECRET=

# RevenueCat SECRET API key (v1, `sk_…`) for admin comp access (ENG-1194): grants
# and revokes the `content` promotional entitlement. SERVER-ONLY — read only by
# lib/revenuecat.ts from app/api/admin/**; never prefix with NEXT_PUBLIC_ and never
# reference it from a "use client" file (a unit test greps for exactly that).
# Unset → the comp endpoint answers 503 revenuecat_not_configured.
REVENUECAT_SECRET_API_KEY=
