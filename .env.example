# Supabase project (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for the internal push-dispatch Edge Function (verify_jwt=false).
# Sent as the `x-dispatch-secret` header by the admin publish route. SERVER-ONLY —
# never prefix with NEXT_PUBLIC_ and never read it from a client component.
# Must match PUSH_DISPATCH_SECRET set on the Supabase project.
PUSH_DISPATCH_SECRET=
